API_KEY=your-api-key-here
TRANSCRIPT_LANGUAGES=pl,en

# Optional MCP. Keep disabled until OAuth and deployment have been approved.
MCP_ENABLED=false
# Set all four values before enabling. Values below are examples, not live endpoints.
MCP_RESOURCE_URL=https://your-service.example.com/mcp
MCP_OAUTH_ISSUER=https://your-tenant.example.com/
MCP_OAUTH_JWKS_URL=https://your-tenant.example.com/.well-known/jwks.json
# Exact provider sub claim(s), comma-separated. Empty means startup fails when enabled.
MCP_ALLOWED_SUBJECTS=
